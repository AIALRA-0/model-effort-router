{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ExampleOrg-0/model-effort-router/main/schemas/recommendation.schema.json",
  "title": "Next iteration route recommendation",
  "type": "object",
  "required": [
    "version",
    "task_class",
    "primary",
    "alternatives",
    "execution_status",
    "segment_continuity",
    "acceptance_contract"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "task_class": {
      "type": "string"
    },
    "primary": {
      "$ref": "#/$defs/route"
    },
    "alternatives": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "execution_status": {
      "enum": [
        "recommendation_only",
        "switch_available_but_unconfirmed",
        "confirmed_switched"
      ]
    },
    "segment_continuity": {
      "type": "object",
      "required": ["policy", "decision", "handoff_required", "locked_route", "recommended_route"],
      "properties": {
        "policy": {"const": "locked_until_boundary"},
        "decision": {
          "enum": [
            "start_new_locked_segment",
            "continue_locked_segment",
            "keep_locked_route_until_boundary",
            "create_verified_handoff",
            "await_target_route_readback",
            "verified_switch_accepted"
          ]
        },
        "handoff_required": {"type": "boolean"},
        "locked_route": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/lockedRoute"}
          ]
        },
        "recommended_route": {"$ref": "#/$defs/lockedRoute"}
      },
      "additionalProperties": false
    },
    "policy_confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "calibration_status": {
      "type": "string"
    },
    "required_before_execution": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_contract": {
      "type": "object"
    }
  },
  "$defs": {
    "lockedRoute": {
      "type": "object",
      "required": ["model", "effort"],
      "properties": {
        "model": {"enum": ["sol", "terra", "luna", "chatgpt-pro-web"]},
        "effort": {"type": "string"}
      },
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "required": [
        "profile",
        "model",
        "effort",
        "display_name",
        "reasons",
        "escalation_triggers",
        "downgrade_triggers"
      ],
      "properties": {
        "profile": {
          "enum": [
            "quality_first",
            "guarded_high",
            "balanced"
          ]
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "escalation_triggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "downgrade_triggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tradeoff": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": true
}
